{
  "name": "SafeGen",
  "description": "Do Not Connect register of Australian children's phone numbers. Platforms check a number before letting it open or link an account.",
  "version": "1.0.0",
  "updated": "2026-10-20",
  "homepage": "https://www.safegen.com.au/",
  "documentation": "https://ricricho.github.io/safegen-docs/docs/agent-discovery.html",
  "api_reference": "https://www.safegen.com.au/api-docs",
  "llms_txt": "https://ricricho.github.io/safegen-docs/llms.txt",
  "signup_page": "https://www.safegen.com.au/developers/sign-up",
  "evaluation_kit": "https://github.com/RicRicho/safegen-evaluation-kit",
  "contact": "https://www.safegen.com.au/contact",
  "auth": {
    "type": "bearer",
    "header": "Authorization: Bearer <key>",
    "test_key": "self-serve, issued at once, shown once",
    "production_key": "issued after organisation review"
  },
  "limits": {
    "test_rate_limit_per_hour": 60,
    "test_inputs": [
      "fixture:match",
      "fixture:no-match",
      "fixture:no-block",
      "fixture:unknown",
      "fixture:error"
    ]
  },
  "endpoints": [
    {
      "method": "POST",
      "url": "https://www.safegen.com.au/api/integrations/signup",
      "auth": "none",
      "request_json": {
        "orgName": "string",
        "contactName": "string",
        "contactEmail": "string",
        "website": "string (optional)"
      },
      "responses": {
        "201": [
          "accountId",
          "orgName",
          "contactEmail",
          "status",
          "testApiKey",
          "keyPrefix",
          "rateLimitPerHour",
          "docsUrl",
          "next"
        ],
        "409": "email already registered"
      }
    },
    {
      "method": "POST",
      "url": "https://www.safegen.com.au/api/check",
      "auth": "bearer",
      "request_json": {
        "phone": "string (fixture:* on test keys)"
      },
      "responses": {
        "200": [
          "listed",
          "blockRequested",
          "action",
          "checkedAt"
        ],
        "400": "test_fixtures_only",
        "401": "unauthorized",
        "503": "simulated_outage (fixture:error)"
      },
      "actions": {
        "reject": "refuse the account link",
        "allow": "carry on with normal checks; not proof of adulthood",
        "unknown": "hold for retry or review"
      }
    },
    {
      "method": "POST",
      "url": "https://www.safegen.com.au/api/integrations/request-production",
      "auth": "bearer (test key)",
      "request_json": {},
      "responses": {
        "202": [
          "accountId",
          "orgName",
          "status: production_pending",
          "requestedAt",
          "message"
        ]
      }
    }
  ],
  "verified": "2026-10-20 Australia/Sydney, from public pages only",
  "owner": "Sam, SafeGen manager"
}
