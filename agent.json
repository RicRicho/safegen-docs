{
  "name": "SafeGen",
  "description": "Register of Australian phone numbers that parents have put on the Safe List because they belong to a child. Platforms check a number at sign-up and refuse accounts the parent asked to block.",
  "version": "0.2.0-discovery",
  "updated": "2026-10-20",
  "homepage": "https://www.safegen.com.au/",
  "documentation": "https://ricricho.github.io/safegen-docs/docs/agent-discovery.html",
  "llms_txt": "https://ricricho.github.io/safegen-docs/llms.txt",
  "status": {
    "live_site": true,
    "self_service_test_keys": true,
    "api_auth_required": true,
    "production_keys": "after_organisation_review",
    "offline_practice_kit": true,
    "openapi": false
  },
  "surfaces": {
    "brand": "https://www.safegen.com.au/",
    "platform_guide": "https://www.safegen.com.au/api-docs",
    "developer_signup": "https://www.safegen.com.au/developers/sign-up",
    "scoreboard": "https://www.safegen.com.au/scoreboard",
    "evaluation_kit": "https://github.com/RicRicho/safegen-evaluation-kit"
  },
  "auth": {
    "type": "bearer",
    "header": "Authorization: Bearer <key>",
    "test_key_prefix": "sg_test_",
    "obtain": "POST https://www.safegen.com.au/api/integrations/signup"
  },
  "endpoints": [
    {
      "method": "POST",
      "url": "https://www.safegen.com.au/api/integrations/signup",
      "auth": "none",
      "request_json": {
        "orgName": "string (required)",
        "contactName": "string",
        "contactEmail": "string",
        "website": "string"
      },
      "returns": "test API key"
    },
    {
      "method": "POST",
      "url": "https://www.safegen.com.au/api/check",
      "auth": "bearer",
      "request_json": {
        "countryCode": "+61",
        "phone": "string, or fixture:* with a test key"
      },
      "response_json_keys": [
        "listed",
        "blockRequested",
        "action",
        "checkedAt"
      ],
      "unauthenticated": "401 with sign-up guidance"
    },
    {
      "method": "POST",
      "url": "https://www.safegen.com.au/api/integrations/request-production",
      "auth": "bearer (test key)",
      "notes": "SafeGen reviews the organisation, then issues a production key"
    },
    {
      "method": "GET",
      "url": "https://www.safegen.com.au/api/stats",
      "auth": "none"
    }
  ],
  "limits": {
    "test_keys": "fixture:* values only, hourly rate limit"
  },
  "fixtures": [
    "fixture:match",
    "fixture:no-match",
    "fixture:no-block",
    "fixture:unknown",
    "fixture:error"
  ],
  "decisions": {
    "reject": "do not create the account",
    "allow": "continue with other eligibility checks; not proof of adulthood",
    "unknown_or_error": "hold for retry or review"
  },
  "evaluation_kit": {
    "package": "@safegen/evaluation-kit",
    "version": "0.1.0",
    "license": "MIT",
    "repo": "https://github.com/RicRicho/safegen-evaluation-kit",
    "run": [
      "node --test test.mjs",
      "node example.mjs"
    ],
    "limits": {
      "network": "loopback 127.0.0.1 only",
      "quota_requests": 30,
      "body_limit_bytes": 1024
    }
  },
  "tracking": {
    "discoverability": "Linear RIC-78",
    "delivery_owner": "Sam (SafeGen manager), Linear RIC-226"
  }
}
